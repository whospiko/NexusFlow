# ==============================================================================
# NexusFlow Frontend Environment Configuration (Example Template)
# Copy to .env and adjust values for your environment (staging/production/local)
# ==============================================================================

# Local Vite Dev Server Port
VITE_PORT=3000

# Backend API Target (for Vite dev proxy)
VITE_BACKEND_TARGET=http://localhost:5050

# REST API Base URL
# Local Dev: /api
# Staging / Production: https://api.yourdomain.com/api (or /api if reverse proxied via Nginx)
VITE_API_URL=/api

# Real-time Collaborative Engine (Socket.IO) URL
# Local Dev: leave empty to use current window.location.origin
# Staging / Production: https://api.yourdomain.com
VITE_SOCKET_URL=

# App Metadata
VITE_APP_NAME=NexusFlow

